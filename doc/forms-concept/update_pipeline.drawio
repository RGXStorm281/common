                <mxCell id="84" value="The visibility is overwritten in every case by intention. If there are external dependencies, these should be reflected in the visibility condition or an extension referencing an accompanying model instead of directly writing to the unstable field &quot;IsVisible&quot;." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="770" y="365" width="210" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="85" value="The validation state is fully reset on each evaluation by intention. Like with the visibility, by design the form state should always be deterministic based on the current form values and the values in accompanying models. So if persistent errors are needed, these should be reflected in an accompanying model referenced by the validators." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="770" y="1145" width="210" height="215" as="geometry"/>
                </mxCell>
                <mxCell id="87" style="edgeStyle=none;html=1;" parent="1" source="86" target="84" edge="1">

                </mxCell>
                <mxCell id="122" style="edgeStyle=none;html=1;" parent="1" source="86" target="121" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="86" value="Note, that Extensions and Validators should NOT hold state on their own. They need to be stateless, because with template instantiation they might be executed on multiple different nodes and are not cloned themselves.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Instead, they may reference bound values or objects of the current node, its parents or descendants or they might reference an external model.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0" parent="1" vertex="1">
                    <mxGeometry x="1100" y="352.5" width="210" height="215" as="geometry"/>

// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet
{
	"name": "C# (.NET)",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/dotnet:1-9.0",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csharp",
				"ms-dotnettools.csdevkit",
				"patcx.vscode-nuget-gallery",
				"EditorConfig.EditorConfig",
				"csharpier.csharpier-vscode",
				"esbenp.prettier-vscode",
				"streetsidesoftware.code-spell-checker",
				"hediet.vscode-drawio",
				"PrateekMahendrakar.resxpress",
				"DotJoshJohnson.xml"
			]
		}
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [5000, 5001],
	// "portsAttributes": {
	//		"5001": {
	//			"protocol": "https"
	//		}
	// }

	// Use 'onCreateCommand' to run commands after the container is initialized.
	"onCreateCommand": {
		"allowPostCreateScript": "sudo chmod +x /workspaces/common/post-create.sh",
		"allowBuildNugetScript": "sudo chmod +x /workspaces/common/buildLocalNuget.sh",
		"initializeWorkloads": "/bin/bash ./post-create.sh"
	},

	// Mount host volumes.
	"mounts": [
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/local-nuget/,target=/local-nuget,type=bind,consistency=cached"
	]

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}

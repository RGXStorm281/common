// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet
{
	"name": "C# (.NET)",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/dotnet:1-9.0",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csdevkit",
				"patcx.vscode-nuget-gallery",
				"EditorConfig.EditorConfig",
				"csharpier.csharpier-vscode",
				"esbenp.prettier-vscode"
			]
		}
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [5000, 5001],
	// "portsAttributes": {
	//		"5001": {
	//			"protocol": "https"
	//		}
	// }

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": {
		"initializeWorkloads": "sudo dotnet workload update",
		"restoreTools": "dotnet tool restore",
		"mountLocalNuget": "dotnet nuget add source /local-nuget -n local",
		"restoreDotNet": "dotnet restore /workspaces/common/src",
		"allowBuildingLocalNuget": "chmod +rwx /workspaces/common/buildLocalNuget.sh"
	},

	// Mount host volumes.
	"mounts": [
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/local-nuget/,target=/local-nuget,type=bind,consistency=cached"
	]

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}

{
	"editor.formatOnSave": true,
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"[csharp]": {
		"editor.defaultFormatter": "csharpier.csharpier-vscode"
	},
	"[xml]": {
		"editor.defaultFormatter": "DotJoshJohnson.xml"
	},
	"cSpell.words": [
		"aabbcc",
		"abcdabc",
		"abcdabcd",
		"accessibilities",
		"Cloneable",
		"Enumerables",
		"Epple",
		"Fieldset",
		"htmx",
		"Iban",
		"importmap",
		"Incrementors",
		"inhertidoc",
		"jquery",
		"libmagic",
		"Memberwise",
		"nameof",
		"pkill",
		"REASYNCGEN",
		"REFWRAPGEN",
		"resetted",
		"resheader",
		"resmimetype",
		"resx",
		"stylesheet",
		"summands",
		"toggleable"
	],
	"files.eol": "\n",
	"xmlTools.enableXmlTreeView": false,
	"xmlTools.enableXmlTreeViewMetadata": false,
	"xmlTools.enforcePrettySelfClosingTagOnFormat": true,
	"xmlTools.removeCommentsOnMinify": true,
	"editor.inlineSuggest.enabled": false
}

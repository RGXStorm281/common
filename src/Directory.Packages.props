<Project>
    <PropertyGroup>
        <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="IbanNet" Version="5.18.0" />
        <PackageVersion Include="libphonenumber-csharp" Version="9.0.3" />
        <PackageVersion Include="Mime" Version="3.7.0" />
        <PackageVersion Include="RobinEpple.Common.Forms" Version="$(Version)" />
        <PackageVersion Include="RobinEpple.Common.Forms.Wrappers" Version="$(Version)" />
        <PackageVersion Include="RobinEpple.Common.Forms.Wrappers.Abstractions" Version="$(Version)" />
        <PackageVersion Include="RobinEpple.Common.SourceGenerators" Version="$(Version)" />
        <PackageVersion Include="RobinEpple.Common.SourceGenerators.Abstractions" Version="$(Version)" />
        <PackageVersion Include="RobinEpple.Common.Util" Version="$(Version)" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageVersion Include="MSTest" Version="3.6.1" />
        <PackageVersion Include="Microsoft.AspNetCore.Html.Abstractions" Version="2.3.0" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="9.0.7" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" />
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.6" />
    </ItemGroup>
</Project>
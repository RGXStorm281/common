<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>RobinEpple.Common.WebUi</AssemblyName>
        <PackageId>RobinEpple.Common.WebUi</PackageId>
        <RootNamespace>RobinEpple.Common.WebUi</RootNamespace>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Title>Private Library for Web User Interfaces</Title>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <PackageReference Include="RobinEpple.Common.Util" />
        <PackageReference Include="RobinEpple.Common.Forms" />
        <PackageReference Include="RobinEpple.Common.Html" />
        <PackageReference Include="RobinEpple.Common.Forms.Html" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

</Project>
